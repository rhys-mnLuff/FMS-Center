NODE_1_WRITE_KEY=replace-with-a-new-random-secret
# Configure production values through Sites environment variables.

# SMS alerts (PhilSMS). All optional: with no token set, ingest works and nothing is sent.
PHILSMS_TOKEN=            # secret, from app.philsms.com > Developers
PHILSMS_SENDER_ID=        # an APPROVED sender name on your PhilSMS account
ADMIN_NUMBERS=            # secret, comma-separated; get battery alerts
SMS_INBOUND_KEY=          # secret, long random; guards POST /sms-inbound?key=
SMS_ADMIN_KEY=            # secret, long random; guards POST /sms-subscribers (bulk-load numbers)
SMS_OPT_OUT=0             # set 1 only once STOP replies actually reach /sms-inbound
SITE_NAME_1=              # as in the firmware, e.g. "Node 2"
SITE_LAT_LONG=            # fallback "lat,long" when a reading has no GPS
